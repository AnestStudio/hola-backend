# ===============================
# APPLICATION
# ===============================
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ===============================
# DATABASE (MySQL)
# ===============================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hola
DB_URL=jdbc:mysql://localhost:3306/hola?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=Password12345678

# ===============================
# SECURITY / JWT & CORS
# ===============================
JWT_SECRET=hola-backend-local-dev-secret-key-must-be-at-least-32-bytes-long
JWT_ACCESS_EXPIRATION_SECONDS=3600
JWT_REFRESH_EXPIRATION_SECONDS=604800
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

