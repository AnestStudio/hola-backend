# ===============================
# APPLICATION
# ===============================
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ===============================
# DATABASE (MySQL)
# ===============================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hola
DB_URL=jdbc:mysql://localhost:3306/hola?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=Password12345678

# ===============================
# SECURITY / JWT & CORS
# ===============================
JWT_SECRET=hola-backend-local-dev-secret-key-must-be-at-least-32-bytes-long
JWT_ACCESS_EXPIRATION_SECONDS=3600
JWT_REFRESH_EXPIRATION_SECONDS=604800
JWT_CLEANUP_CRON=0 0 3 * * *
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ===============================
# MAIL (SMTP)
# ===============================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@hola.edu.vn

